# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Notificações push (painel admin) — gere um par novo com
# `npx web-push generate-vapid-keys` e use o mesmo valor público nas duas
# variáveis abaixo (uma é lida no servidor, a outra no navegador).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Segredo que o gatilho do banco (Supabase) envia pra provar que a chamada
# é legítima — mesmo valor usado no arquivo supabase/add_push_notifications.sql
PUSH_WEBHOOK_SECRET=
